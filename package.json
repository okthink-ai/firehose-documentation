{
  "name": "firehose-documentation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro sync --force && astro build",
    "preview": "astro preview",
    "check": "astro check && markdownlint-cli2 && npm run build && node scripts/check-links.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:external": "node scripts/check-links.mjs --external",
    "test:browser": "playwright test",
    "check:example": "node --test examples/hello-firehose/greeting.test.mjs examples/hello-firehose-result/greeting.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/starlight": "0.42.0",
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "cheerio": "1.2.0",
    "markdownlint-cli2": "0.23.2",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "markdownlint-cli2": {
      "smol-toml": "1.8.0"
    }
  }
}
