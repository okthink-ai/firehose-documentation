{
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", "dist/**", ".astro/**", "CLAUDE.md", "test-results/**", "playwright-report/**"],
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD024": { "siblings_only": true },
    "MD060": false
  }
}
